#!/usr/bin/env python3
"""sbp-skills — Mission-critical cognitive autonomy for SBP engineering teams."""

import argparse
import json
import os
import re
import shutil
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path

__version__ = "0.1.0"


# ---------------------------------------------------------------------------
# Configuration & TOML parsing
# ---------------------------------------------------------------------------

def parse_detection_toml(path: Path) -> dict:
    """Parse detection.toml into {name: {files: [...], pack: str, depends: [...]}}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    result = {}
    for name, section in raw.items():
        result[name] = {
            "files": section.get("files", []),
            "pack": section.get("pack", name),
            "depends": section.get("depends", []),
        }
    return result


def parse_defaults_toml(path: Path) -> dict:
    """Parse defaults.toml into {skills: [...], commands: [...]}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    return {
        "skills": raw.get("skills", {}).get("default", []),
        "commands": raw.get("commands", {}).get("default", []),
    }


def parse_pack_manifest(path: Path) -> dict:
    """Parse a pack's manifest.toml into a flat dict."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    pack = raw.get("pack", {})
    detect = raw.get("detect", {})
    targets = raw.get("targets", {})
    return {
        "name": pack.get("name", ""),
        "description": pack.get("description", ""),
        "version": pack.get("version", "0.0.0"),
        "authors": pack.get("authors", []),
        "detect_files": detect.get("files", []),
        "targets": {
            "agents_md": targets.get("agents_md", False),
            "claude_md": targets.get("claude_md", False),
            "commands": targets.get("commands", False),
        },
    }


# ---------------------------------------------------------------------------
# Fragment merging
# ---------------------------------------------------------------------------

def insert_fragment(content: str, fragment_id: str, fragment_body: str) -> str:
    """Insert or replace a fragment in content. Preserves LOCAL sections."""
    begin_marker = f"<!-- BEGIN {fragment_id} -->"
    end_marker = f"<!-- END {fragment_id} -->"
    new_block = f"{begin_marker}\n{fragment_body.rstrip()}\n{end_marker}\n"

    if begin_marker in content:
        # Replace existing fragment
        lines = content.split("\n")
        result = []
        skipping = False
        replaced = False
        for line in lines:
            if line.strip() == begin_marker:
                skipping = True
                if not replaced:
                    result.append(new_block.rstrip())
                    replaced = True
                continue
            if skipping and line.strip() == end_marker:
                skipping = False
                continue
            if not skipping:
                result.append(line)
        return "\n".join(result) + "\n" if not content.endswith("\n") else "\n".join(result)
    else:
        # Append before LOCAL section if it exists, otherwise append at end
        local_marker = "<!-- LOCAL -->"
        if local_marker in content:
            idx = content.index(local_marker)
            return content[:idx] + new_block + "\n" + content[idx:]
        else:
            separator = "\n" if content and not content.endswith("\n") else ""
            return content + separator + new_block


def remove_fragment(content: str, fragment_id: str) -> str:
    """Remove a fragment from content."""
    begin_marker = f"<!-- BEGIN {fragment_id} -->"
    end_marker = f"<!-- END {fragment_id} -->"

    if begin_marker not in content:
        return content

    lines = content.split("\n")
    result = []
    skipping = False
    for line in lines:
        if line.strip() == begin_marker:
            skipping = True
            continue
        if skipping and line.strip() == end_marker:
            skipping = False
            continue
        if not skipping:
            result.append(line)

    cleaned = "\n".join(result)
    while "\n\n\n" in cleaned:
        cleaned = cleaned.replace("\n\n\n", "\n\n")
    return cleaned


def extract_fragment_ids(content: str) -> list[str]:
    """Extract all fragment IDs from content in order."""
    ids = []
    for line in content.split("\n"):
        stripped = line.strip()
        if stripped.startswith("<!-- BEGIN ") and stripped.endswith(" -->"):
            fid = stripped[len("<!-- BEGIN "):-len(" -->")]
            ids.append(fid)
    return ids


# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------

TOOL_DIRS = {
    "claude-code": {
        "marker": ".claude",
        "skills_dir": ".claude/skills",
        "commands_dir": ".claude/commands",
        "agent_file": "CLAUDE.md",
    },
    "copilot": {
        "marker": ".copilot",
        "skills_dir": None,
        "commands_dir": None,
        "agent_file": ".github/copilot-instructions.md",
    },
    "opencode": {
        "marker": ".config/opencode",
        "skills_dir": ".config/opencode/skills",
        "commands_dir": None,
        "agent_file": None,
    },
}


def detect_tools(home: Path) -> dict:
    """Detect installed AI coding tools by checking for config directories."""
    found = {}
    for tool_name, info in TOOL_DIRS.items():
        marker = home / info["marker"]
        if marker.is_dir():
            found[tool_name] = {
                "skills_dir": home / info["skills_dir"] if info["skills_dir"] else None,
                "commands_dir": home / info["commands_dir"] if info["commands_dir"] else None,
                "agent_file": info["agent_file"],
            }
    return found


def detect_stack(project_dir: Path, detection_rules: dict) -> set[str]:
    """Detect which packs apply to a project based on file patterns."""
    detected = set()
    for name, rule in detection_rules.items():
        for pattern in rule["files"]:
            matches = list(project_dir.glob(pattern))
            if matches:
                detected.add(rule["pack"])
                for dep in rule.get("depends", []):
                    detected.add(dep)
                break
    return detected


# ---------------------------------------------------------------------------
# Manifest tracking
# ---------------------------------------------------------------------------

def create_manifest(central_repo: str, tools: list, baseline_version: str,
                    packs: dict, skills: dict) -> dict:
    """Create a new manifest dict."""
    return {
        "version": "1",
        "last_update": datetime.now(timezone.utc).isoformat(),
        "central_repo": central_repo,
        "tools_detected": tools,
        "baseline": {"version": baseline_version},
        "packs": packs,
        "skills": skills,
        "removed": [],
    }


def save_manifest(project_dir: Path, manifest: dict) -> None:
    """Write manifest to .sbp/manifest.json."""
    sbp_dir = project_dir / ".sbp"
    sbp_dir.mkdir(exist_ok=True)
    manifest["last_update"] = datetime.now(timezone.utc).isoformat()
    with open(sbp_dir / "manifest.json", "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")


def load_manifest(project_dir: Path) -> dict | None:
    """Load manifest from .sbp/manifest.json, or None if missing."""
    path = project_dir / ".sbp" / "manifest.json"
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)


# ---------------------------------------------------------------------------
# SKILL.md parsing
# ---------------------------------------------------------------------------

def _parse_frontmatter(text: str) -> dict:
    """Parse simple YAML-like frontmatter (flat keys + one nested dict level). Stdlib only."""
    result = {}
    current_key = None
    current_dict = None
    current_scalar_lines = None

    for line in text.split("\n"):
        if not line.strip() or line.strip().startswith("#"):
            continue

        # Indented line — either nested dict entry or continuation of a scalar
        if line.startswith("  ") or line.startswith("\t"):
            stripped = line.strip()
            # Check if it's a key: value pair (nested dict)
            kv_match = re.match(r"^([\w][\w-]*):\s+(.*)", stripped)
            if kv_match and current_key and current_dict is not None:
                current_dict[kv_match.group(1)] = kv_match.group(2).strip().strip("'\"")
            elif current_scalar_lines is not None:
                # Continuation of a multi-line scalar
                current_scalar_lines.append(stripped)
            continue

        # Top-level key
        top_match = re.match(r"^([\w][\w-]*):\s*(.*)", line)
        if top_match:
            # Finalize previous key
            if current_key and current_dict is not None:
                result[current_key] = current_dict
            elif current_key and current_scalar_lines is not None:
                result[current_key] = " ".join(current_scalar_lines)

            key = top_match.group(1)
            value = top_match.group(2).strip()

            if not value:
                # Start of a nested dict
                current_key = key
                current_dict = {}
                current_scalar_lines = None
            else:
                # Scalar value (might have continuations)
                current_key = key
                current_dict = None
                current_scalar_lines = [value.strip("'\"")]

    # Finalize last key
    if current_key and current_dict is not None:
        result[current_key] = current_dict
    elif current_key and current_scalar_lines is not None:
        result[current_key] = " ".join(current_scalar_lines)

    return result


def parse_skill_md(content: str) -> dict | None:
    """Parse a SKILL.md file with YAML frontmatter and markdown body."""
    if not content.strip().startswith("---"):
        return None

    parts = content.split("---", 2)
    if len(parts) < 3:
        return None

    frontmatter_text = parts[1].strip()
    body = parts[2].strip()

    fm = _parse_frontmatter(frontmatter_text)
    if not fm.get("name"):
        return None

    return {
        "name": fm["name"],
        "description": fm.get("description", ""),
        "metadata": fm.get("metadata", {}),
        "body": body,
    }


# ---------------------------------------------------------------------------
# Rendering — assemble fragments into project files
# ---------------------------------------------------------------------------

def _extract_body(content: str) -> str:
    """Extract body between BEGIN/END markers, or return full content if no markers."""
    lines = content.split("\n")
    body_lines = []
    in_body = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("<!-- BEGIN "):
            in_body = True
            continue
        if stripped.startswith("<!-- END "):
            in_body = False
            continue
        if in_body:
            body_lines.append(line)
    return "\n".join(body_lines) if body_lines else content


def render_agents_md(project_dir: Path, repo_root: Path, detected_packs: set) -> None:
    """Render AGENTS.md with baseline + detected pack fragments."""
    agents_path = project_dir / "AGENTS.md"
    content = agents_path.read_text() if agents_path.exists() else ""

    # Insert baseline
    baseline = (repo_root / "baseline" / "AGENTS.md").read_text()
    baseline_body = _extract_body(baseline)
    content = insert_fragment(content, "baseline", baseline_body)

    # Insert detected pack fragments
    for pack_name in sorted(detected_packs):
        pack_agents = repo_root / "packs" / pack_name / "AGENTS.md"
        if pack_agents.exists():
            pack_body = _extract_body(pack_agents.read_text())
            content = insert_fragment(content, f"pack: {pack_name}", pack_body)

    # Remove pack fragments no longer detected
    existing_ids = extract_fragment_ids(content)
    for fid in existing_ids:
        if fid.startswith("pack: "):
            pack_name = fid[len("pack: "):]
            if pack_name not in detected_packs:
                content = remove_fragment(content, fid)

    agents_path.write_text(content)


def render_claude_md(project_dir: Path, repo_root: Path, detected_packs: set) -> None:
    """Render CLAUDE.md with baseline + detected pack fragments (if they have CLAUDE.md)."""
    claude_path = project_dir / "CLAUDE.md"
    content = claude_path.read_text() if claude_path.exists() else ""

    baseline_claude = repo_root / "baseline" / "CLAUDE.md"
    if baseline_claude.exists():
        baseline_body = _extract_body(baseline_claude.read_text())
        content = insert_fragment(content, "baseline", baseline_body)

    for pack_name in sorted(detected_packs):
        pack_claude = repo_root / "packs" / pack_name / "CLAUDE.md"
        if pack_claude.exists():
            pack_body = _extract_body(pack_claude.read_text())
            content = insert_fragment(content, f"pack: {pack_name}", pack_body)

    claude_path.write_text(content)


def copy_commands(project_dir: Path, repo_root: Path, defaults: list,
                  detected_packs: set) -> None:
    """Copy default and pack commands to .claude/commands/."""
    commands_dir = project_dir / ".claude" / "commands"
    commands_dir.mkdir(parents=True, exist_ok=True)

    for cmd_name in defaults:
        src = repo_root / "baseline" / "commands" / f"{cmd_name}.md"
        if src.exists():
            shutil.copy2(src, commands_dir / f"{cmd_name}.md")

    for pack_name in sorted(detected_packs):
        pack_cmds = repo_root / "packs" / pack_name / "commands"
        if pack_cmds.is_dir():
            for cmd_file in pack_cmds.glob("*.md"):
                shutil.copy2(cmd_file, commands_dir / cmd_file.name)


def link_skills(home: Path, repo_root: Path, skills: list, tool: str) -> None:
    """Symlink skills to the tool's skills directory."""
    tool_info = TOOL_DIRS.get(tool, {})
    skills_rel = tool_info.get("skills_dir")
    if not skills_rel:
        return

    skills_dir = home / skills_rel
    skills_dir.mkdir(parents=True, exist_ok=True)

    for skill_name in skills:
        src = repo_root / "skills" / skill_name
        dst = skills_dir / skill_name
        if src.is_dir():
            if dst.exists() or dst.is_symlink():
                if dst.is_symlink():
                    dst.unlink()
                else:
                    shutil.rmtree(dst)
            dst.symlink_to(src)


def main():
    parser = argparse.ArgumentParser(
        prog="sbp-skills",
        description="Mission-critical cognitive autonomy for SBP engineering teams.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    subparsers = parser.add_subparsers(dest="command")

    def cmd_init(args):
        """Initialize sbp-skills in the current project."""
        project_dir = Path.cwd()
        home = Path.home()
        repo_root = Path(__file__).resolve().parent.parent

        # 1. Detect AI tools
        tools = detect_tools(home)
        if not tools:
            print("No AI coding tools detected. Install Claude Code, GitHub Copilot, or OpenCode first.")
            sys.exit(1)
        tool_names = list(tools.keys())
        print(f"Tools detected: {', '.join(tool_names)}")

        # 2. Detect stack
        detection_rules = parse_detection_toml(repo_root / "detection.toml")
        detected_packs = detect_stack(project_dir, detection_rules)

        # Check for explicitly removed packs
        existing_manifest = load_manifest(project_dir)
        if existing_manifest:
            removed = set(existing_manifest.get("removed", []))
            detected_packs -= removed

        # Resolve dependencies
        all_depends = set()
        for name in list(detected_packs):
            for rule_name, rule in detection_rules.items():
                if rule["pack"] == name:
                    for dep in rule.get("depends", []):
                        all_depends.add(dep)
        detected_packs |= all_depends

        pack_display = sorted(detected_packs) if detected_packs else ["(none)"]
        print(f"Packs activated: baseline, {', '.join(pack_display)}")

        # 3. Load defaults
        defaults = parse_defaults_toml(repo_root / "defaults.toml")

        # 4. Render AGENTS.md
        render_agents_md(project_dir, repo_root, detected_packs)
        print("  Rendered AGENTS.md")

        # 5. Render CLAUDE.md (if Claude Code detected)
        if "claude-code" in tools:
            render_claude_md(project_dir, repo_root, detected_packs)
            print("  Rendered CLAUDE.md")

        # 6. Copy commands
        if "claude-code" in tools:
            copy_commands(project_dir, repo_root, defaults["commands"], detected_packs)
            print(f"  Installed {len(defaults['commands'])} commands to .claude/commands/")

        # 7. Symlink skills
        for tool_name in tool_names:
            link_skills(home, repo_root, defaults["skills"], tool_name)
        print(f"  Linked {len(defaults['skills'])} default skills")

        # 8. Write manifest
        pack_entries = {}
        for pack_name in detected_packs:
            manifest_path = repo_root / "packs" / pack_name / "manifest.toml"
            if manifest_path.exists():
                pm = parse_pack_manifest(manifest_path)
                detected_by = "explicit"
                for rule_name, rule in detection_rules.items():
                    if rule["pack"] == pack_name:
                        for pattern in rule["files"]:
                            if list(project_dir.glob(pattern)):
                                detected_by = str(list(project_dir.glob(pattern))[0].name)
                                break
                pack_entries[pack_name] = {
                    "version": pm["version"],
                    "source": "auto-detected" if detected_by != "explicit" else "explicit",
                    "detected_by": detected_by,
                }

        skill_entries = {s: {"source": "default"} for s in defaults["skills"]}
        manifest = create_manifest(
            central_repo="local",
            tools=tool_names,
            baseline_version="1.0.0",
            packs=pack_entries,
            skills=skill_entries,
        )
        save_manifest(project_dir, manifest)
        print("  Wrote .sbp/manifest.json")

        print(f"\nRun 'sbp-skills list' to see available packs and skills.")
        print(f"Run 'sbp-skills browse' to enable more.")

    p_init = subparsers.add_parser("init", help="Initialize sbp-skills in the current project")
    p_init.set_defaults(func=cmd_init)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)
    if hasattr(args, "func"):
        args.func(args)


if __name__ == "__main__":
    main()
