#!/usr/bin/env python3
"""sbp-skills — Mission-critical cognitive autonomy for SBP engineering teams."""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path

__version__ = "1.0.0"

# ---------------------------------------------------------------------------
# Repo root resolution — find where baseline/, packs/, skills/ live
# ---------------------------------------------------------------------------

_CACHE_DIR = Path.home() / ".cache" / "sbp-skills" / "repo"


def get_repo_root() -> Path:
    """Find the sbp-skills content root. Checks: parent of CLI, then cache dir."""
    # When running from inside the repo (development)
    dev_root = Path(__file__).resolve().parent.parent
    if (dev_root / "baseline" / "AGENTS.md").exists():
        return dev_root
    # When installed via install.sh (content in cache)
    if (_CACHE_DIR / "baseline" / "AGENTS.md").exists():
        return _CACHE_DIR
    # Fallback
    print("Cannot find sbp-skills content. Run the installer or check ~/.cache/sbp-skills/repo/")
    sys.exit(1)


# ---------------------------------------------------------------------------
# Configuration & TOML parsing
# ---------------------------------------------------------------------------

def parse_detection_toml(path: Path) -> dict:
    """Parse detection.toml into {name: {files: [...], pack: str, depends: [...]}}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    result = {}
    for name, section in raw.items():
        result[name] = {
            "files": section.get("files", []),
            "pack": section.get("pack", name),
            "depends": section.get("depends", []),
        }
    return result


def parse_defaults_toml(path: Path) -> dict:
    """Parse defaults.toml into {skills: [...], commands: [...], contributor_commands: [...]}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    return {
        "skills": raw.get("skills", {}).get("default", []),
        "commands": raw.get("commands", {}).get("default", []),
        "contributor_commands": raw.get("commands", {}).get("contributor", []),
    }


def parse_pack_manifest(path: Path) -> dict:
    """Parse a pack's manifest.toml into a flat dict."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    pack = raw.get("pack", {})
    detect = raw.get("detect", {})
    targets = raw.get("targets", {})
    return {
        "name": pack.get("name", ""),
        "description": pack.get("description", ""),
        "version": pack.get("version", "0.0.0"),
        "authors": pack.get("authors", []),
        "detect_files": detect.get("files", []),
        "targets": {
            "agents_md": targets.get("agents_md", False),
            "claude_md": targets.get("claude_md", False),
            "commands": targets.get("commands", False),
        },
    }




# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------

TOOL_DIRS = {
    "claude-code": {
        "marker": ".claude",
        "skills_dir": ".claude/skills",
        "commands_dir": ".claude/commands",
        "agent_file": "CLAUDE.md",
    },
    "copilot": {
        "marker": ".copilot",
        "skills_dir": None,
        "commands_dir": ".github/copilot/prompts",
        "agent_file": ".github/copilot-instructions.md",
    },
    "opencode": {
        "marker": ".config/opencode",
        "skills_dir": ".config/opencode/skills",
        "commands_dir": None,
        "agent_file": None,
    },
}


def claude_dir(home: Path) -> Path:
    """Return the Claude config directory, honouring CLAUDE_CONFIG_DIR if set."""
    env = os.environ.get("CLAUDE_CONFIG_DIR", "").strip()
    return Path(env).expanduser() if env else home / ".claude"


def detect_tools(home: Path) -> dict:
    """Detect installed AI coding tools by checking for config directories."""
    found = {}
    _claude_dir = claude_dir(home)
    for tool_name, info in TOOL_DIRS.items():
        if tool_name == "claude-code":
            marker = _claude_dir
            skills_dir = _claude_dir / "skills" if info["skills_dir"] else None
            commands_dir = _claude_dir / "commands" if info["commands_dir"] else None
        else:
            marker = home / info["marker"]
            skills_dir = home / info["skills_dir"] if info["skills_dir"] else None
            commands_dir = home / info["commands_dir"] if info["commands_dir"] else None
        if marker.is_dir():
            found[tool_name] = {
                "skills_dir": skills_dir,
                "commands_dir": commands_dir,
                "agent_file": info["agent_file"],
            }
    return found


def detect_stack(project_dir: Path, detection_rules: dict) -> set[str]:
    """Detect which packs apply to a project based on file patterns."""
    detected = set()
    for name, rule in detection_rules.items():
        for pattern in rule["files"]:
            matches = list(project_dir.glob(pattern))
            if matches:
                detected.add(rule["pack"])
                for dep in rule.get("depends", []):
                    detected.add(dep)
                break
    return detected


# ---------------------------------------------------------------------------
# Manifest tracking
# ---------------------------------------------------------------------------

def create_manifest(central_repo: str, tools: list, baseline_version: str,
                    packs: dict, skills: dict) -> dict:
    """Create a new manifest dict."""
    return {
        "version": "1",
        "last_update": datetime.now(timezone.utc).isoformat(),
        "central_repo": central_repo,
        "tools_detected": tools,
        "baseline": {"version": baseline_version},
        "packs": packs,
        "skills": skills,
        "removed": [],
    }


def save_manifest(project_dir: Path, manifest: dict) -> None:
    """Write manifest to .sbp/manifest.json."""
    sbp_dir = project_dir / ".sbp"
    sbp_dir.mkdir(exist_ok=True)
    manifest["last_update"] = datetime.now(timezone.utc).isoformat()
    with open(sbp_dir / "manifest.json", "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")


def load_manifest(project_dir: Path) -> dict | None:
    """Load manifest from .sbp/manifest.json, or None if missing."""
    path = project_dir / ".sbp" / "manifest.json"
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)


# ---------------------------------------------------------------------------
# SKILL.md parsing
# ---------------------------------------------------------------------------

def _parse_frontmatter(text: str) -> dict:
    """Parse simple YAML-like frontmatter (flat keys + one nested dict level). Stdlib only."""
    result = {}
    current_key = None
    current_dict = None
    current_scalar_lines = None

    for line in text.split("\n"):
        if not line.strip() or line.strip().startswith("#"):
            continue

        # Indented line — either nested dict entry or continuation of a scalar
        if line[0:1] in (" ", "\t") and line.strip():
            stripped = line.strip()
            # Check if it's a key: value pair (nested dict)
            kv_match = re.match(r"^([\w][\w-]*):\s+(.*)", stripped)
            if kv_match and current_key and current_dict is not None:
                current_dict[kv_match.group(1)] = kv_match.group(2).strip().strip("'\"")
            elif current_scalar_lines is not None:
                # Continuation of a multi-line scalar
                current_scalar_lines.append(stripped)
            continue

        # Top-level key
        top_match = re.match(r"^([\w][\w-]*):\s*(.*)", line)
        if top_match:
            # Finalize previous key
            if current_key and current_dict is not None:
                result[current_key] = current_dict
            elif current_key and current_scalar_lines is not None:
                result[current_key] = " ".join(current_scalar_lines)

            key = top_match.group(1)
            value = top_match.group(2).strip()

            if not value:
                # Start of a nested dict
                current_key = key
                current_dict = {}
                current_scalar_lines = None
            else:
                # Scalar value (might have continuations)
                current_key = key
                current_dict = None
                current_scalar_lines = [value.strip("'\"")]

    # Finalize last key
    if current_key and current_dict is not None:
        result[current_key] = current_dict
    elif current_key and current_scalar_lines is not None:
        result[current_key] = " ".join(current_scalar_lines)

    return result


def parse_skill_md(content: str) -> dict | None:
    """Parse a SKILL.md file with YAML frontmatter and markdown body."""
    if not content.strip().startswith("---"):
        return None

    parts = content.split("---", 2)
    if len(parts) < 3:
        return None

    frontmatter_text = parts[1].strip()
    body = parts[2].strip()

    fm = _parse_frontmatter(frontmatter_text)
    if not fm.get("name"):
        return None

    return {
        "name": fm["name"],
        "description": fm.get("description", ""),
        "metadata": fm.get("metadata", {}),
        "body": body,
    }


# ---------------------------------------------------------------------------
# Rendering — assemble fragments into project files
# ---------------------------------------------------------------------------

def render_agents_md(project_dir: Path, repo_root: Path, detected_packs: set) -> None:
    """Render AGENTS.md by concatenating baseline + detected pack fragments."""
    parts = []

    # Baseline
    baseline = repo_root / "baseline" / "AGENTS.md"
    if baseline.exists():
        parts.append(baseline.read_text().strip())

    # Detected pack fragments
    for pack_name in sorted(detected_packs):
        pack_agents = repo_root / "packs" / pack_name / "AGENTS.md"
        if pack_agents.exists():
            parts.append(pack_agents.read_text().strip())

    managed_content = "\n\n".join(parts)

    # Preserve local additions below separator
    agents_path = project_dir / "AGENTS.md"
    local_content = ""
    if agents_path.exists():
        existing = agents_path.read_text()
        separator = "\n---\n"
        if separator in existing:
            local_content = existing.split(separator, 1)[1]

    result = managed_content
    if local_content:
        result += "\n\n---\n" + local_content

    agents_path.write_text(result + "\n")


def render_claude_md(project_dir: Path, repo_root: Path, detected_packs: set) -> None:
    """Render CLAUDE.md by concatenating baseline + detected pack fragments."""
    parts = []

    baseline_claude = repo_root / "baseline" / "CLAUDE.md"
    if baseline_claude.exists():
        parts.append(baseline_claude.read_text().strip())

    for pack_name in sorted(detected_packs):
        pack_claude = repo_root / "packs" / pack_name / "CLAUDE.md"
        if pack_claude.exists():
            parts.append(pack_claude.read_text().strip())

    if not parts:
        return

    managed_content = "\n\n".join(parts)

    claude_path = project_dir / "CLAUDE.md"
    local_content = ""
    if claude_path.exists():
        existing = claude_path.read_text()
        separator = "\n---\n"
        if separator in existing:
            local_content = existing.split(separator, 1)[1]

    result = managed_content
    if local_content:
        result += "\n\n---\n" + local_content

    claude_path.write_text(result + "\n")


def copy_commands(project_dir: Path, repo_root: Path, defaults: list,
                  detected_packs: set) -> None:
    """Copy default and pack commands to .claude/commands/."""
    commands_dir = project_dir / ".claude" / "commands"
    commands_dir.mkdir(parents=True, exist_ok=True)

    for cmd_name in defaults:
        src = repo_root / "baseline" / "commands" / f"{cmd_name}.md"
        if src.exists():
            shutil.copy2(src, commands_dir / f"{cmd_name}.md")

    for pack_name in sorted(detected_packs):
        pack_cmds = repo_root / "packs" / pack_name / "commands"
        if pack_cmds.is_dir():
            for cmd_file in pack_cmds.glob("*.md"):
                shutil.copy2(cmd_file, commands_dir / cmd_file.name)


def copy_copilot_prompts(project_dir: Path, repo_root: Path, defaults: list,
                         detected_packs: set) -> int:
    """Copy commands as .prompt.md files to .github/copilot/prompts/ for Copilot Chat."""
    prompts_dir = project_dir / ".github" / "copilot" / "prompts"
    prompts_dir.mkdir(parents=True, exist_ok=True)
    count = 0

    for cmd_name in defaults:
        src = repo_root / "baseline" / "commands" / f"{cmd_name}.md"
        if src.exists():
            shutil.copy2(src, prompts_dir / f"{cmd_name}.prompt.md")
            count += 1

    for pack_name in sorted(detected_packs):
        pack_cmds = repo_root / "packs" / pack_name / "commands"
        if pack_cmds.is_dir():
            for cmd_file in pack_cmds.glob("*.md"):
                shutil.copy2(cmd_file, prompts_dir / f"{cmd_file.stem}.prompt.md")
                count += 1

    return count


def link_skills(home: Path, repo_root: Path, skills: list, tool: str) -> None:
    """Symlink skills to the tool's skills directory."""
    tool_info = TOOL_DIRS.get(tool, {})
    skills_rel = tool_info.get("skills_dir")
    if not skills_rel:
        return

    skills_dir = home / skills_rel
    skills_dir.mkdir(parents=True, exist_ok=True)

    for skill_name in skills:
        src = repo_root / "skills" / skill_name
        dst = skills_dir / skill_name
        if src.is_dir():
            if dst.exists() or dst.is_symlink():
                if dst.is_symlink():
                    dst.unlink()
                else:
                    shutil.rmtree(dst)
            dst.symlink_to(src)


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

def validate_pack(pack_dir: Path) -> list[str]:
    """Validate a pack directory. Returns list of error strings (empty = valid)."""
    errors = []
    name = pack_dir.name

    manifest_path = pack_dir / "manifest.toml"
    if not manifest_path.exists():
        errors.append(f"Missing manifest.toml in {name}/")
        return errors

    pm = parse_pack_manifest(manifest_path)

    if pm.get("name") and pm["name"] != name:
        errors.append(f"manifest.toml name '{pm['name']}' does not match directory name '{name}'")

    agents_path = pack_dir / "AGENTS.md"
    if not agents_path.exists():
        errors.append(f"Missing AGENTS.md in {name}/")
    else:
        content = agents_path.read_text()
        word_count = len(content.split())
        if word_count > 300:
            errors.append(f"AGENTS.md is {word_count} words (max 300)")

    if not (pack_dir / "README.md").exists():
        errors.append(f"Missing README.md in {name}/")

    if len(pm.get("description", "")) < 50:
        errors.append(f"Description too short (min 50 characters)")

    return errors


def validate_skill(skill_dir: Path) -> list[str]:
    """Validate a skill directory. Returns list of error strings (empty = valid)."""
    errors = []
    name = skill_dir.name

    skill_md = skill_dir / "SKILL.md"
    if not skill_md.exists():
        errors.append(f"Missing SKILL.md in {name}/")
        return errors

    skill = parse_skill_md(skill_md.read_text())
    if skill is None:
        errors.append(f"Failed to parse SKILL.md frontmatter in {name}/")
        return errors

    if skill["name"] != name:
        errors.append(f"SKILL.md name '{skill['name']}' does not match directory name '{name}'")

    if len(skill["name"]) > 64:
        errors.append(f"Skill name too long (max 64 characters)")
    if not re.match(r"^[a-z][a-z0-9-]*$", skill["name"]):
        errors.append(f"Skill name must be lowercase letters, numbers, and hyphens")

    if len(skill["description"]) < 50:
        errors.append(f"Description too short: {len(skill['description'])} chars (min 50)")
    if len(skill["description"]) > 1024:
        errors.append(f"Description too long: {len(skill['description'])} chars (max 1024)")

    return errors


def main():
    parser = argparse.ArgumentParser(
        prog="sbp-skills",
        description="Mission-critical cognitive autonomy for SBP engineering teams.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    subparsers = parser.add_subparsers(dest="command")

    def cmd_init(args):
        """Initialize sbp-skills in the current project."""
        project_dir = Path.cwd()
        home = Path.home()
        repo_root = get_repo_root()

        # 1. Detect AI tools
        tools = detect_tools(home)
        if not tools:
            print("No AI coding tools detected. Install Claude Code, GitHub Copilot, or OpenCode first.")
            sys.exit(1)
        tool_names = list(tools.keys())
        print(f"Tools detected: {', '.join(tool_names)}")

        # 2. Detect stack
        detection_rules = parse_detection_toml(repo_root / "detection.toml")
        detected_packs = detect_stack(project_dir, detection_rules)

        # Check for explicitly removed packs
        existing_manifest = load_manifest(project_dir)
        if existing_manifest:
            removed = set(existing_manifest.get("removed", []))
            detected_packs -= removed

        pack_display = sorted(detected_packs) if detected_packs else ["(none)"]
        print(f"Packs activated: baseline, {', '.join(pack_display)}")

        # 3. Load defaults
        defaults = parse_defaults_toml(repo_root / "defaults.toml")

        # 4. Render AGENTS.md
        render_agents_md(project_dir, repo_root, detected_packs)
        print("  Rendered AGENTS.md")

        # 5. Render CLAUDE.md (if Claude Code detected)
        if "claude-code" in tools:
            render_claude_md(project_dir, repo_root, detected_packs)
            print("  Rendered CLAUDE.md")

        # 5b. Render Copilot instructions and prompts (if Copilot detected)
        if "copilot" in tools:
            copilot_dir = project_dir / ".github"
            copilot_dir.mkdir(parents=True, exist_ok=True)
            copilot_file = copilot_dir / "copilot-instructions.md"
            # Copilot reads this file — write the same content as AGENTS.md
            agents_content = (project_dir / "AGENTS.md").read_text()
            copilot_file.write_text(agents_content)
            print("  Rendered .github/copilot-instructions.md")

            # Copy commands as Copilot reusable prompts
            all_copilot_cmds = defaults["commands"] + defaults.get("contributor_commands", [])
            prompt_count = copy_copilot_prompts(project_dir, repo_root, all_copilot_cmds, detected_packs)
            print(f"  Installed {prompt_count} prompts to .github/copilot/prompts/")

        # 6. Copy commands (daily-use + contributor)
        if "claude-code" in tools:
            all_commands = defaults["commands"] + defaults.get("contributor_commands", [])
            copy_commands(project_dir, repo_root, all_commands, detected_packs)
            print(f"  Installed {len(all_commands)} commands to .claude/commands/")

        # 7. Symlink skills
        for tool_name in tool_names:
            link_skills(home, repo_root, defaults["skills"], tool_name)
        print(f"  Linked {len(defaults['skills'])} default skills")

        # 8. Write manifest
        pack_entries = {}
        for pack_name in detected_packs:
            manifest_path = repo_root / "packs" / pack_name / "manifest.toml"
            if manifest_path.exists():
                pm = parse_pack_manifest(manifest_path)
                detected_by = "explicit"
                for rule_name, rule in detection_rules.items():
                    if rule["pack"] == pack_name:
                        for pattern in rule["files"]:
                            if list(project_dir.glob(pattern)):
                                detected_by = str(list(project_dir.glob(pattern))[0].name)
                                break
                pack_entries[pack_name] = {
                    "version": pm["version"],
                    "source": "auto-detected" if detected_by != "explicit" else "explicit",
                    "detected_by": detected_by,
                }

        skill_entries = {s: {"source": "default"} for s in defaults["skills"]}
        manifest = create_manifest(
            central_repo="local",
            tools=tool_names,
            baseline_version="1.0.0",
            packs=pack_entries,
            skills=skill_entries,
        )
        save_manifest(project_dir, manifest)
        print("  Wrote .sbp/manifest.json")

        # 9. Add .sbp/ to .gitignore if needed
        gitignore = project_dir / ".gitignore"
        if gitignore.exists():
            content = gitignore.read_text()
            if ".sbp/" not in content:
                with open(gitignore, "a") as f:
                    f.write("\n# sbp-skills manifest (machine-specific)\n.sbp/\n")
                print("  Added .sbp/ to .gitignore")
        else:
            gitignore.write_text("# sbp-skills manifest (machine-specific)\n.sbp/\n")
            print("  Created .gitignore with .sbp/")

        print(f"\nYour AI agent now thinks mission-critical.")
        print(f"Try /review, /challenge, or /what-if-this-fails in your next session.")
        print(f"Run 'sbp-skills list' to see all available skills.")

    p_init = subparsers.add_parser("init", help="Initialize sbp-skills in the current project")
    p_init.set_defaults(func=cmd_init)

    def cmd_update(args):
        """Update sbp-skills to latest from central repo."""
        project_dir = Path.cwd()
        home = Path.home()
        repo_root = get_repo_root()

        manifest = load_manifest(project_dir)
        if manifest is None:
            print("No .sbp/manifest.json found. Run 'sbp-skills init' first.")
            sys.exit(1)

        tools = detect_tools(home)
        detection_rules = parse_detection_toml(repo_root / "detection.toml")
        detected_packs = detect_stack(project_dir, detection_rules)

        removed = set(manifest.get("removed", []))
        detected_packs -= removed

        for pack_name, info in manifest.get("packs", {}).items():
            if info.get("source") == "explicit":
                detected_packs.add(pack_name)

        defaults = parse_defaults_toml(repo_root / "defaults.toml")

        old_packs = set(manifest.get("packs", {}).keys())
        added_packs = detected_packs - old_packs
        removed_packs = old_packs - detected_packs

        render_agents_md(project_dir, repo_root, detected_packs)
        if "claude-code" in tools:
            render_claude_md(project_dir, repo_root, detected_packs)
            all_commands = defaults["commands"] + defaults.get("contributor_commands", [])
            copy_commands(project_dir, repo_root, all_commands, detected_packs)

        if "copilot" in tools:
            copilot_dir = project_dir / ".github"
            copilot_dir.mkdir(parents=True, exist_ok=True)
            copilot_file = copilot_dir / "copilot-instructions.md"
            agents_content = (project_dir / "AGENTS.md").read_text()
            copilot_file.write_text(agents_content)
            print("  Rendered .github/copilot-instructions.md")

            all_copilot_cmds = defaults["commands"] + defaults.get("contributor_commands", [])
            prompt_count = copy_copilot_prompts(project_dir, repo_root, all_copilot_cmds, detected_packs)
            print(f"  Installed {prompt_count} prompts to .github/copilot/prompts/")

        all_skills = list(set(defaults["skills"]) | set(manifest.get("skills", {}).keys()))
        for tool_name in tools:
            link_skills(home, repo_root, all_skills, tool_name)

        pack_entries = {}
        for pack_name in detected_packs:
            manifest_path = repo_root / "packs" / pack_name / "manifest.toml"
            if manifest_path.exists():
                pm = parse_pack_manifest(manifest_path)
                old_info = manifest.get("packs", {}).get(pack_name, {})
                pack_entries[pack_name] = {
                    "version": pm["version"],
                    "source": old_info.get("source", "auto-detected"),
                    "detected_by": old_info.get("detected_by", "unknown"),
                }

        manifest["packs"] = pack_entries
        manifest["tools_detected"] = list(tools.keys())
        save_manifest(project_dir, manifest)

        if added_packs:
            print(f"Added packs: {', '.join(sorted(added_packs))}")
        if removed_packs:
            print(f"Removed packs: {', '.join(sorted(removed_packs))}")
        if not added_packs and not removed_packs:
            print("All packs up to date.")
        print("Update complete.")

    p_update = subparsers.add_parser("update", help="Update to latest from central repo")
    p_update.set_defaults(func=cmd_update)

    def cmd_list(args):
        """List available packs and skills."""
        project_dir = Path.cwd()
        repo_root = get_repo_root()

        manifest = load_manifest(project_dir)

        print("PACKS:")
        packs_dir = repo_root / "packs"
        if packs_dir.is_dir():
            for pack_dir in sorted(packs_dir.iterdir()):
                if pack_dir.is_dir() and (pack_dir / "manifest.toml").exists():
                    pm = parse_pack_manifest(pack_dir / "manifest.toml")
                    status = ""
                    if manifest and pm["name"] in manifest.get("packs", {}):
                        source = manifest["packs"][pm["name"]].get("source", "")
                        status = f" [{source}]"
                    elif manifest and pm["name"] in manifest.get("removed", []):
                        status = " [removed]"
                    print(f"  {pm['name']:<20} {pm['description']}{status}")

        print("\nSKILLS:")
        skills_dir = repo_root / "skills"
        defaults = parse_defaults_toml(repo_root / "defaults.toml")
        if skills_dir.is_dir():
            for skill_dir in sorted(skills_dir.iterdir()):
                skill_md = skill_dir / "SKILL.md"
                if skill_md.exists():
                    skill = parse_skill_md(skill_md.read_text())
                    if skill:
                        is_default = skill["name"] in defaults["skills"]
                        is_enabled = manifest and skill["name"] in manifest.get("skills", {})
                        status = " [default]" if is_default else (" [enabled]" if is_enabled else "")
                        print(f"  {skill['name']:<25} {skill['description'][:60]}{status}")

        print("\nCOMMANDS:")
        for cmd_name in defaults["commands"]:
            cmd_file = repo_root / "baseline" / "commands" / f"{cmd_name}.md"
            if cmd_file.exists():
                first_line = cmd_file.read_text().split("\n")[0].strip()
                print(f"  /{cmd_name:<20} {first_line}")

    p_list = subparsers.add_parser("list", help="List available packs, skills, and commands")
    p_list.set_defaults(func=cmd_list)

    def cmd_add(args):
        """Add a domain pack explicitly."""
        project_dir = Path.cwd()
        repo_root = get_repo_root()
        pack_name = args.pack

        pack_dir = repo_root / "packs" / pack_name
        if not pack_dir.is_dir():
            print(f"Pack '{pack_name}' not found. Run 'sbp-skills list' to see available packs.")
            sys.exit(1)

        manifest = load_manifest(project_dir)
        if manifest is None:
            print("Run 'sbp-skills init' first.")
            sys.exit(1)

        if pack_name in manifest.get("removed", []):
            manifest["removed"].remove(pack_name)

        pm = parse_pack_manifest(pack_dir / "manifest.toml")
        manifest["packs"][pack_name] = {
            "version": pm["version"],
            "source": "explicit",
            "detected_by": "manual",
        }
        save_manifest(project_dir, manifest)

        detected_packs = set(manifest["packs"].keys())
        render_agents_md(project_dir, repo_root, detected_packs)

        tools = detect_tools(Path.home())
        if "claude-code" in tools:
            render_claude_md(project_dir, repo_root, detected_packs)

        if "copilot" in tools:
            copilot_file = project_dir / ".github" / "copilot-instructions.md"
            if copilot_file.exists() or (project_dir / ".github").is_dir():
                agents_content = (project_dir / "AGENTS.md").read_text()
                copilot_file.write_text(agents_content)

        print(f"Added pack: {pack_name}")

    p_add = subparsers.add_parser("add", help="Add a domain pack explicitly")
    p_add.add_argument("pack", help="Pack name (e.g., terraform)")
    p_add.set_defaults(func=cmd_add)

    def cmd_remove(args):
        """Remove a domain pack."""
        project_dir = Path.cwd()
        repo_root = get_repo_root()
        pack_name = args.pack

        manifest = load_manifest(project_dir)
        if manifest is None:
            print("Run 'sbp-skills init' first.")
            sys.exit(1)

        manifest["packs"].pop(pack_name, None)
        if pack_name not in manifest.get("removed", []):
            manifest["removed"].append(pack_name)
        save_manifest(project_dir, manifest)

        detected_packs = set(manifest["packs"].keys())
        render_agents_md(project_dir, repo_root, detected_packs)

        tools = detect_tools(Path.home())
        if "claude-code" in tools:
            render_claude_md(project_dir, repo_root, detected_packs)

        if "copilot" in tools:
            copilot_file = project_dir / ".github" / "copilot-instructions.md"
            if copilot_file.exists() or (project_dir / ".github").is_dir():
                agents_content = (project_dir / "AGENTS.md").read_text()
                copilot_file.write_text(agents_content)

        print(f"Removed pack: {pack_name}")

    p_remove = subparsers.add_parser("remove", help="Remove a domain pack")
    p_remove.add_argument("pack", help="Pack name to remove")
    p_remove.set_defaults(func=cmd_remove)

    def cmd_enable(args):
        """Enable a skill."""
        home = Path.home()
        repo_root = get_repo_root()
        skill_name = args.skill

        skill_dir = repo_root / "skills" / skill_name
        if not skill_dir.is_dir():
            print(f"Skill '{skill_name}' not found. Run 'sbp-skills list' to see available skills.")
            sys.exit(1)

        if args.glob:
            tools = detect_tools(home)
            for tool_name in tools:
                link_skills(home, repo_root, [skill_name], tool_name)
            print(f"Enabled skill globally: {skill_name}")
        else:
            project_dir = Path.cwd()
            manifest = load_manifest(project_dir)
            if manifest is None:
                print("Run 'sbp-skills init' first.")
                sys.exit(1)
            manifest.setdefault("skills", {})[skill_name] = {"source": "enabled"}
            save_manifest(project_dir, manifest)
            tools = detect_tools(home)
            for tool_name in tools:
                link_skills(home, repo_root, [skill_name], tool_name)
            print(f"Enabled skill: {skill_name}")

    p_enable = subparsers.add_parser("enable", help="Enable a skill")
    p_enable.add_argument("skill", help="Skill name")
    p_enable.add_argument("--global", dest="glob", action="store_true", help="Enable globally")
    p_enable.set_defaults(func=cmd_enable)

    def cmd_disable(args):
        """Disable a skill."""
        home = Path.home()
        skill_name = args.skill

        for tool_name, info in TOOL_DIRS.items():
            if info["skills_dir"]:
                link = home / info["skills_dir"] / skill_name
                if link.is_symlink():
                    link.unlink()

        project_dir = Path.cwd()
        manifest = load_manifest(project_dir)
        if manifest:
            manifest.get("skills", {}).pop(skill_name, None)
            save_manifest(project_dir, manifest)

        print(f"Disabled skill: {skill_name}")

    p_disable = subparsers.add_parser("disable", help="Disable a skill")
    p_disable.add_argument("skill", help="Skill name")
    p_disable.set_defaults(func=cmd_disable)

    def cmd_doctor(args):
        """Health check."""
        home = Path.home()
        repo_root = get_repo_root()
        project_dir = Path.cwd()
        ok = True

        v = sys.version_info
        status = "OK" if v >= (3, 11) else "WARN: need 3.11+"
        print(f"Python: {v.major}.{v.minor}.{v.micro} {status}")

        try:
            subprocess.run(["git", "--version"], capture_output=True, check=True)
            print("Git: OK")
        except (subprocess.CalledProcessError, FileNotFoundError):
            print("Git: NOT FOUND")
            ok = False

        tools = detect_tools(home)
        if tools:
            print(f"AI tools: {', '.join(tools.keys())}")
        else:
            print("AI tools: NONE DETECTED")
            ok = False

        manifest = load_manifest(project_dir)
        if manifest:
            print(f"Project initialized: yes ({len(manifest.get('packs', {}))} packs)")
        else:
            print("Project initialized: no (run 'sbp-skills init')")

        if (repo_root / "baseline" / "AGENTS.md").exists():
            print("Central repo: OK")
        else:
            print("Central repo: NOT FOUND")
            ok = False

        sys.exit(0 if ok else 1)

    p_doctor = subparsers.add_parser("doctor", help="Health check")
    p_doctor.set_defaults(func=cmd_doctor)

    def cmd_validate(args):
        """Validate packs or skills."""
        has_errors = False
        for path_str in args.paths:
            path = Path(path_str)
            if not path.is_dir():
                print(f"SKIP: {path} is not a directory")
                continue

            if (path / "manifest.toml").exists():
                errors = validate_pack(path)
                label = f"pack:{path.name}"
            elif (path / "SKILL.md").exists():
                errors = validate_skill(path)
                label = f"skill:{path.name}"
            else:
                print(f"SKIP: {path} is neither a pack nor a skill")
                continue

            if errors:
                print(f"FAIL {label}")
                for e in errors:
                    print(f"  - {e}")
                has_errors = True
            else:
                print(f"OK   {label}")

        sys.exit(1 if has_errors else 0)

    p_validate = subparsers.add_parser("validate", help="Validate packs or skills")
    p_validate.add_argument("paths", nargs="+", help="Pack or skill directories to validate")
    p_validate.set_defaults(func=cmd_validate)

    def cmd_dev(args):
        """Scaffold a new pack or skill."""
        name = args.name
        repo_root = get_repo_root()

        if args.pack:
            target = repo_root / "packs" / name
            if target.exists():
                print(f"Pack '{name}' already exists at {target}")
                sys.exit(1)
            target.mkdir(parents=True)

            (target / "manifest.toml").write_text(
                f'[pack]\nname = "{name}"\n'
                f'description = "TODO: describe what this pack does (min 50 characters)"\n'
                f'version = "0.1.0"\nauthors = ["Schuberg Philis"]\n\n'
                f'[detect]\nfiles = ["TODO: add file patterns"]\n\n'
                f'[targets]\nagents_md = true\nclaude_md = false\ncommands = false\n'
            )
            (target / "AGENTS.md").write_text(
                f'## {name.replace("-", " ").title()} Conventions\n\n'
                f'TODO: Write imperative, verifiable instructions.\n\n'
                f'**Acceptance criteria:**\n- [ ] TODO\n'
            )
            (target / "README.md").write_text(
                f'# {name.replace("-", " ").title()} Pack\n\n'
                f'TODO: Describe what this pack does and why it matters.\n'
            )
            print(f"Created pack scaffold at {target}/")
            print(f"Next: edit the files, then run 'sbp-skills validate {target}'")

        elif args.skill:
            target = repo_root / "skills" / name
            if target.exists():
                print(f"Skill '{name}' already exists at {target}")
                sys.exit(1)
            target.mkdir(parents=True)

            (target / "SKILL.md").write_text(
                f'---\nname: {name}\n'
                f'description: "TODO: describe what this skill does (min 50 characters)"\n'
                f'metadata:\n  domain: TODO\n  lifecycle: TODO\n---\n\n'
                f'# {name.replace("-", " ").title()}\n\n'
                f'TODO: Write instructions for the agent.\n'
            )
            print(f"Created skill scaffold at {target}/")
            print(f"Next: edit SKILL.md, then run 'sbp-skills validate {target}'")

        else:
            print("Specify --pack or --skill")
            sys.exit(1)

    p_dev = subparsers.add_parser("dev", help="Scaffold a new pack or skill")
    p_dev.add_argument("name", help="Name (lowercase-with-hyphens)")
    p_dev.add_argument("--pack", action="store_true", help="Create a domain pack")
    p_dev.add_argument("--skill", action="store_true", help="Create a skill")
    p_dev.set_defaults(func=cmd_dev)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)
    if hasattr(args, "func"):
        args.func(args)


if __name__ == "__main__":
