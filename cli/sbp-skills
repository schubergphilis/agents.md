#!/usr/bin/env python3
"""sbp-skills — Mission-critical cognitive autonomy for SBP engineering teams."""

import argparse
import json
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path

__version__ = "0.1.0"


# ---------------------------------------------------------------------------
# Configuration & TOML parsing
# ---------------------------------------------------------------------------

def parse_detection_toml(path: Path) -> dict:
    """Parse detection.toml into {name: {files: [...], pack: str, depends: [...]}}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    result = {}
    for name, section in raw.items():
        result[name] = {
            "files": section.get("files", []),
            "pack": section.get("pack", name),
            "depends": section.get("depends", []),
        }
    return result


def parse_defaults_toml(path: Path) -> dict:
    """Parse defaults.toml into {skills: [...], commands: [...]}."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    return {
        "skills": raw.get("skills", {}).get("default", []),
        "commands": raw.get("commands", {}).get("default", []),
    }


def parse_pack_manifest(path: Path) -> dict:
    """Parse a pack's manifest.toml into a flat dict."""
    with open(path, "rb") as f:
        raw = tomllib.load(f)
    pack = raw.get("pack", {})
    detect = raw.get("detect", {})
    targets = raw.get("targets", {})
    return {
        "name": pack.get("name", ""),
        "description": pack.get("description", ""),
        "version": pack.get("version", "0.0.0"),
        "authors": pack.get("authors", []),
        "detect_files": detect.get("files", []),
        "targets": {
            "agents_md": targets.get("agents_md", False),
            "claude_md": targets.get("claude_md", False),
            "commands": targets.get("commands", False),
        },
    }


# ---------------------------------------------------------------------------
# Fragment merging
# ---------------------------------------------------------------------------

def insert_fragment(content: str, fragment_id: str, fragment_body: str) -> str:
    """Insert or replace a fragment in content. Preserves LOCAL sections."""
    begin_marker = f"<!-- BEGIN {fragment_id} -->"
    end_marker = f"<!-- END {fragment_id} -->"
    new_block = f"{begin_marker}\n{fragment_body.rstrip()}\n{end_marker}\n"

    if begin_marker in content:
        # Replace existing fragment
        lines = content.split("\n")
        result = []
        skipping = False
        replaced = False
        for line in lines:
            if line.strip() == begin_marker:
                skipping = True
                if not replaced:
                    result.append(new_block.rstrip())
                    replaced = True
                continue
            if skipping and line.strip() == end_marker:
                skipping = False
                continue
            if not skipping:
                result.append(line)
        return "\n".join(result) + "\n" if not content.endswith("\n") else "\n".join(result)
    else:
        # Append before LOCAL section if it exists, otherwise append at end
        local_marker = "<!-- LOCAL -->"
        if local_marker in content:
            idx = content.index(local_marker)
            return content[:idx] + new_block + "\n" + content[idx:]
        else:
            separator = "\n" if content and not content.endswith("\n") else ""
            return content + separator + new_block


def remove_fragment(content: str, fragment_id: str) -> str:
    """Remove a fragment from content."""
    begin_marker = f"<!-- BEGIN {fragment_id} -->"
    end_marker = f"<!-- END {fragment_id} -->"

    if begin_marker not in content:
        return content

    lines = content.split("\n")
    result = []
    skipping = False
    for line in lines:
        if line.strip() == begin_marker:
            skipping = True
            continue
        if skipping and line.strip() == end_marker:
            skipping = False
            continue
        if not skipping:
            result.append(line)

    cleaned = "\n".join(result)
    while "\n\n\n" in cleaned:
        cleaned = cleaned.replace("\n\n\n", "\n\n")
    return cleaned


def extract_fragment_ids(content: str) -> list[str]:
    """Extract all fragment IDs from content in order."""
    ids = []
    for line in content.split("\n"):
        stripped = line.strip()
        if stripped.startswith("<!-- BEGIN ") and stripped.endswith(" -->"):
            fid = stripped[len("<!-- BEGIN "):-len(" -->")]
            ids.append(fid)
    return ids


# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------

TOOL_DIRS = {
    "claude-code": {
        "marker": ".claude",
        "skills_dir": ".claude/skills",
        "commands_dir": ".claude/commands",
        "agent_file": "CLAUDE.md",
    },
    "copilot": {
        "marker": ".copilot",
        "skills_dir": None,
        "commands_dir": None,
        "agent_file": ".github/copilot-instructions.md",
    },
    "opencode": {
        "marker": ".config/opencode",
        "skills_dir": ".config/opencode/skills",
        "commands_dir": None,
        "agent_file": None,
    },
}


def detect_tools(home: Path) -> dict:
    """Detect installed AI coding tools by checking for config directories."""
    found = {}
    for tool_name, info in TOOL_DIRS.items():
        marker = home / info["marker"]
        if marker.is_dir():
            found[tool_name] = {
                "skills_dir": home / info["skills_dir"] if info["skills_dir"] else None,
                "commands_dir": home / info["commands_dir"] if info["commands_dir"] else None,
                "agent_file": info["agent_file"],
            }
    return found


def detect_stack(project_dir: Path, detection_rules: dict) -> set[str]:
    """Detect which packs apply to a project based on file patterns."""
    detected = set()
    for name, rule in detection_rules.items():
        for pattern in rule["files"]:
            matches = list(project_dir.glob(pattern))
            if matches:
                detected.add(rule["pack"])
                for dep in rule.get("depends", []):
                    detected.add(dep)
                break
    return detected


# ---------------------------------------------------------------------------
# Manifest tracking
# ---------------------------------------------------------------------------

def create_manifest(central_repo: str, tools: list, baseline_version: str,
                    packs: dict, skills: dict) -> dict:
    """Create a new manifest dict."""
    return {
        "version": "1",
        "last_update": datetime.now(timezone.utc).isoformat(),
        "central_repo": central_repo,
        "tools_detected": tools,
        "baseline": {"version": baseline_version},
        "packs": packs,
        "skills": skills,
        "removed": [],
    }


def save_manifest(project_dir: Path, manifest: dict) -> None:
    """Write manifest to .sbp/manifest.json."""
    sbp_dir = project_dir / ".sbp"
    sbp_dir.mkdir(exist_ok=True)
    manifest["last_update"] = datetime.now(timezone.utc).isoformat()
    with open(sbp_dir / "manifest.json", "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")


def load_manifest(project_dir: Path) -> dict | None:
    """Load manifest from .sbp/manifest.json, or None if missing."""
    path = project_dir / ".sbp" / "manifest.json"
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)


def main():
    parser = argparse.ArgumentParser(
        prog="sbp-skills",
        description="Mission-critical cognitive autonomy for SBP engineering teams.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    subparsers = parser.add_subparsers(dest="command")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
